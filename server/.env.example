# 服务端口
PORT=3000

# MySQL 8.0
DB_HOST=124.220.83.24
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=;/h9<8ftM8#x
DB_NAME=cat_coffee
DB_POOL_LIMIT=20

# JWT
JWT_SECRET=cat_coffee_dev_secret_change_me
JWT_CUSTOMER_EXPIRES=7d
JWT_MERCHANT_EXPIRES=7d
JWT_ADMIN_EXPIRES=2h

# 微信小程序（未配置 appid/secret 时自动进入 MOCK 模式，便于本地联调）
WX_APPID=
WX_SECRET=
WX_MOCK=true

# 上传
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5
STATIC_PREFIX=/uploads

# 是否开启定时任务
ENABLE_CRON=true

# 超管后台前端同域托管（admin-web 构建产物）
# 目录相对 server/ 解析，默认 ../admin-web/dist；设为 false 可关闭托管
SERVE_ADMIN_WEB=true
ADMIN_WEB_DIR=../admin-web/dist
